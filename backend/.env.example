APP_NAME=GroSharey API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE_NAME=grosharey

JWT_SECRET_KEY=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRATION_MINUTES=10080

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Used only when GEMINI_MODEL is overloaded
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Gmail account that sends "you owe" emails, and its 16-character app password
# (myaccount.google.com/apppasswords, needs 2-Step Verification). Leave blank to skip emails.
EMAIL_SENDER_ADDRESS=
EMAIL_APP_PASSWORD=
# Frontend URL used for links in emails
APP_URL=http://localhost:8081
