{
  "expo": {
    "name": "GroSharey",
    "slug": "grosharey",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "GroSharey uses your photos to set your profile picture."
        }
      ]
    ]
  }
}
